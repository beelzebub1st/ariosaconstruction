# Public site uses DB when DATABASE_URL is set.
# Set USE_DATABASE=false to force hardcoded seed content instead.
USE_DATABASE="true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth — REQUIRED on Vercel
AUTH_SECRET="generate-a-long-random-string"

# Public site URL — use your custom domain in production
NEXT_PUBLIC_SITE_URL="https://ariosaconstructions.com"

# Admin credentials (env login works even without DB)
ADMIN_EMAIL="admin@ariosaconstructions.com"
ADMIN_PASSWORD="ariosa-admin-change-me"

# Vercel Blob — required for durable photo uploads on Vercel
# (without it, uploads go to /public/uploads which only works locally)
BLOB_READ_WRITE_TOKEN=""

# Resend email (optional — leads still succeed and log to console)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="ariosaconstructions@gmail.com"
CONTACT_FROM_EMAIL="Ariosa Website <onboarding@resend.dev>"
