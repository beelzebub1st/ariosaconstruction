# Database (optional for now — site runs on hardcoded content)
# Set USE_DATABASE=true after Neon is connected and seeded
USE_DATABASE="false"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-string"

# Public site URL (used for metadata / absolute URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin credentials (env login works even without DB)
ADMIN_EMAIL="admin@ariosaconstructions.com"
ADMIN_PASSWORD="ariosa-admin-change-me"

# Vercel Blob (optional until you upload from admin)
BLOB_READ_WRITE_TOKEN=""

# Resend email (optional — leads still succeed and log to console)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="ariosaconstructions@gmail.com"
CONTACT_FROM_EMAIL="Ariosa Website <onboarding@resend.dev>"
