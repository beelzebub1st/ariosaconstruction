# Public site uses DB when DATABASE_URL is set.
# Set USE_DATABASE=false to force hardcoded seed content instead.
USE_DATABASE="true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/ariosaconstruction?sslmode=require"

# Auth.js / NextAuth — REQUIRED on Vercel
AUTH_SECRET="generate-a-long-random-string"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://www.ariosaconstructionsllc.com"

# Admin credentials (email OR username both work)
ADMIN_EMAIL="admin@ariosaconstructionsllc.com"
ADMIN_USERNAME="ariosaconstructions"
ADMIN_PASSWORD="change-me"

# Vercel Blob — required for durable photo uploads on Vercel
BLOB_READ_WRITE_TOKEN=""

# Resend email (optional)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="ariosaconstructions@gmail.com"
CONTACT_FROM_EMAIL="Ariosa Website <onboarding@resend.dev>"
